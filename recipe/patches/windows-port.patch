+elseif(MSVC)
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} /O2 /openmp /EHsc /bigobj")
+    add_definitions(-DWINDOWS) # preprocessor directive
+    # The POSIX spellings of read/write/open live in <io.h> behind these, and
+    # the sources call the CRT string functions without the _s suffix.
+    add_definitions(-D_CRT_NONSTDC_NO_DEPRECATE -D_CRT_SECURE_NO_WARNINGS)
+    # The MSVC <cmath> declares M_PI only under this, and the sources that use
+    # it reach the math header transitively, so it has to be set for the target.
+    add_definitions(-D_USE_MATH_DEFINES)
