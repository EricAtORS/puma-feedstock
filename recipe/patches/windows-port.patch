 include_directories(${CONDA_PREFIX}/include)
 include_directories(${CONDA_PREFIX}/include/eigen3/Eigen)
+if(MSVC)
+    # A conda prefix on Windows keeps its headers and import libraries under
+    # Library, and the sources reach Eigen by its module names, so the Eigen
+    # directory itself has to be on the include path.
+    include_directories(${CONDA_PREFIX}/Library/include)
