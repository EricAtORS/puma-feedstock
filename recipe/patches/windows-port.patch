+if(MSVC)
+    # -l/-L/-ldl are GNU driver flags. conda-forge's win-64 fftw also builds
+    # threading into the main library, so there is no fftw3_threads to link.
+    find_library(PUMA_TIFF_LIB NAMES tiff libtiff HINTS ${CONDA_PREFIX}/lib ${CONDA_PREFIX}/Library/lib REQUIRED)
+    find_library(PUMA_FFTW3_LIB NAMES fftw3 libfftw3 fftw3-3 libfftw3-3 HINTS ${CONDA_PREFIX}/lib ${CONDA_PREFIX}/Library/lib REQUIRED)
+    SET(DEP_LIBS ${PUMA_TIFF_LIB} ${PUMA_FFTW3_LIB})
+else()
+    SET(DEP_LIBS "-ldl -L${CONDA_PREFIX}/lib -ltiff -lfftw3_threads -lfftw3")
+    if(APPLE)
+        SET(DEP_LIBS "${DEP_LIBS} -lomp")
+    endif()
 endif()
 
 # link dependency libraries to PuMA library
@@ -61,6 +88,8 @@ target_link_libraries(PuMA ${DEP_LIBS})
